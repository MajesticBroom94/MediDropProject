@model MediDropProject.Models.CareProvider.PatientAdherenceViewModel
@{
    Layout = null;
    var generated = DateTimeOffset.Now;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>MediDrop adherence report - @Model.FullName</title>
    <link rel="stylesheet" href="~/css/careProvider/print-documents.css" asp-append-version="true"/>
</head>
<body>
<div class="print-toolbar">
    <a asp-action="Adherence" asp-route-id="@Model.PatientId" asp-route-days="@Model.Days">← Back to adherence</a>
    <button type="button" onclick="window.print()">Print / Save as PDF</button>
</div>
<main class="document">
    <header class="doc-header">
        <div>
            <div class="doc-brand">MediDrop</div>
            <div class="doc-subtitle">Medication dispenser activity report</div>
        </div>
        <div class="doc-tag">Adherence report</div>
    </header>
    <h1>Medication adherence report</h1>
    <p class="lead">Past @Model.Days days · Generated @generated.ToString("dd MMM yyyy HH:mm")</p>
    <div class="details">
        <div class="detail"><span>Patient</span><strong>@Model.FullName</strong></div>
        <div class="detail"><span>Patient email</span><strong>@Model.Email</strong></div>
    </div>
    <section class="metrics" aria-label="Report summary">
        <div class="metric">
            <span>Adherence</span><strong>@(Model.Rate.HasValue ? $"{Model.Rate.Value:0.#}%" : "—")</strong></div>
        <div class="metric"><span>Scheduled</span><strong>@Model.Scheduled</strong></div>
        <div class="metric"><span>Removed</span><strong>@Model.Removed</strong></div>
        <div class="metric"><span>Cancelled</span><strong>@Model.Cancelled</strong></div>
        <div class="metric"><span>Missed</span><strong>@Model.Missed</strong></div>
    </section>
    <h2>Recorded dispenser activity</h2>
    <table>
        <thead>
        <tr>
            <th style="width:24%">Scheduled</th>
            <th style="width:33%">Medication</th>
            <th style="width:20%">Removed at</th>
            <th style="width:23%">Outcome</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Slots)
        {
            <tr>
                <td>@item.ScheduledFor.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                <td>@string.Join(", ", item.Medications)</td>
                <td>@(item.RemovedAt?.ToLocalTime().ToString("dd MMM HH:mm") ?? "—")</td>
                <td>@item.Status.ToString()</td>
            </tr>
        }
        @if (Model.Slots.Count == 0)
        {
            <tr>
                <td colspan="4">No scheduled dispenser activity in this period.</td>
            </tr>
        }
        </tbody>
    </table>
    <footer class="footer">Generated by MediDrop · For informational and care coordination purposes.</footer>
</main>
</body>
</html>
