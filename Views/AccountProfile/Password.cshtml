@model MediDropProject.Models.Account.ChangeAccountPasswordViewModel
@using MediDropProject.Domain.Enums
@inject Microsoft.AspNetCore.Identity.UserManager<MediDropProject.Domain.Entities.ApplicationUser> UserManager
@{
    var account = await UserManager.GetUserAsync(User);
    Layout = User.IsInRole("Admin")
        ? "_AdminLayout"
        : account?.LastSelectedProfile == LastSelectedProfile.CareProvider && User.IsInRole("CareProvider")
            ? "_CareProviderLayout" : "_PatientLayout";
    ViewData["Title"] = "Change password";
    ViewData["Eyebrow"] = "Security";
}
@section Styles { <link rel="stylesheet" href="~/css/account/account-profile.css" asp-append-version="true" /> }
<div class="account-profile-page">
    <div class="account-profile-heading"><div><h1>Change password</h1><p>Choose a new password for your MediDrop account.</p></div><a class="account-profile-back" asp-action="Index">Back to profile</a></div>
    <section class="account-profile-card">
        <div class="account-profile-section-title"><i class="fa-solid fa-lock"></i><div><h2>Password security</h2><p>Enter your current password to confirm this change.</p></div></div>
        <form asp-controller="AccountProfile" asp-action="Password" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="account-profile-errors"></div>
            <div class="account-profile-grid">
                <div class="account-profile-field full"><label asp-for="CurrentPassword"></label><input asp-for="CurrentPassword" autocomplete="current-password" /><span asp-validation-for="CurrentPassword"></span></div>
                <div class="account-profile-field full"><label asp-for="NewPassword"></label><input asp-for="NewPassword" autocomplete="new-password" /><span asp-validation-for="NewPassword"></span></div>
                <div class="account-profile-field full"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span></div>
            </div>
            <p class="account-profile-help">Your new password must meet the existing MediDrop password requirements.</p>
            <div class="account-profile-actions"><a class="account-profile-secondary" asp-action="Index">Cancel</a><button type="submit" class="account-profile-primary"><i class="fa-solid fa-key"></i> Update password</button></div>
        </form>
    </section>
</div>
