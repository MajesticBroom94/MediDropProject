@using MediDropProject.Domain.Enums
@using MediDropProject.Data
@using MediDropProject.Domain.Entities
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject UserManager<ApplicationUser> UserManager
@{
var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Admin";

string Active(params string[] actions) => 
    currentController.Equals("Admin", StringComparison.OrdinalIgnoreCase) &&
    actions.Contains(currentAction, StringComparer.OrdinalIgnoreCase) ? "active" : "";

var isSuperAdmin = User.IsInRole("SuperAdmin");
var currentUser = await UserManager.GetUserAsync(User);
var unread = currentUser == null ? 0
    : await Db.Notifications
        .AsNoTracking()
        .CountAsync(n => n.UserId == currentUser.Id &&
                         n.RecipientProfile == LastSelectedProfile.Admin &&
                         n.ReadAt == null && n.RemovedAt == null);

var notificationBadge = unread > 99 ? "99+" : unread.ToString();


var name = currentUser == null ? "Administrator" : $"{currentUser.FirstName} {currentUser.LastName}".Trim();

if (string.IsNullOrWhiteSpace(name)) name = "Administrator";

var initials = string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2)
    
.Select(x => char.ToUpperInvariant(x[0])));
if (initials.Length == 0) initials = "AD";

}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
    <title>@ViewData["Title"] · MediDrop Admin</title>
    <link rel="icon" type="image/png" href="~/images/medidrop-logo.png" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"/>
    <link rel="stylesheet" href="~/css/admin/admin.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/account/profile-switch.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/admin/admin-profile-menu.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/notification/live-notifications.css" asp-append-version="true"/>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="admin-body">
<div class="admin-shell">
    <div class="admin-backdrop" id="admin-backdrop"></div>
    <aside class="admin-sidebar" id="admin-sidebar" aria-label="Administration navigation">
        <div class="admin-brand-row">
            <a class="admin-brand" asp-controller="Admin" asp-action="Index">
                <img src="~/images/medidrop-logo.png" alt=""/>
                <span><strong>MediDrop</strong><small>Administration</small></span>
            </a>
            <button class="admin-close" id="admin-close" type="button" aria-label="Close menu"><i
                    class="fa-solid fa-xmark"></i></button>
        </div>
        <nav class="admin-nav">
            <span class="admin-nav-label">Overview</span>
            <a class="@Active("Index")" asp-controller="Admin" asp-action="Index"><i class="fa-solid fa-chart-pie"></i>
                Dashboard</a>
            <span class="admin-nav-label">Review queues</span>
            <a class="@Active("ProviderRegistrations", "ProviderRegistrationDetails")" asp-controller="Admin"
               asp-action="ProviderRegistrations"><i class="fa-solid fa-user-doctor"></i> Care providers</a>
            <a class="@Active("Medications", "MedicationDetails", "EditMedication")" asp-controller="Admin" asp-action="Medications"><i
                    class="fa-solid fa-capsules"></i> Medications</a>
            <a class="@Active("Manufacturers")" asp-controller="Admin" asp-action="Manufacturers"><i class="fa-solid fa-industry"></i> Manufacturers</a>
            <span class="admin-nav-label">System oversight</span>
            <a class="@Active("Users", "AccountDetails")" asp-controller="Admin" asp-action="Users"><i class="fa-solid fa-users"></i>
                Accounts</a>
            <a class="@Active("Devices", "DeviceDetails")" asp-controller="Admin" asp-action="Devices"><i
                    class="fa-solid fa-microchip"></i> Devices</a>
            <a class="@Active("Audit")" asp-controller="Admin" asp-action="Audit"><i
                    class="fa-solid fa-shield-halved"></i> Audit &amp; security</a>
            <span class="admin-nav-label">Account</span>
            <a class="@(currentController == "Notification" ? "active" : "")" data-notification-link asp-controller="Notification"
               asp-action="Index">
                <i class="fa-regular fa-bell"></i> Notifications
                @if (unread > 0)
                {
                <span class="admin-nav-count">@notificationBadge</span>
                }
            </a>
        </nav>
        <div class="admin-sidebar-footer">
            <details class="profile-switch-menu admin-profile-menu">
                <summary class="admin-account profile-switch-trigger" aria-label="Open administrator account menu">
                    <span class="admin-avatar" aria-hidden="true">@initials</span>
                    <span class="admin-profile-identity"><strong>@name</strong><small>@currentUser?.Email</small></span>
                    <span class="profile-switch-toggle-icon" aria-hidden="true">
                        <i class="fa-solid fa-chevron-up profile-switch-chevron"></i>
                        <i class="fa-solid fa-xmark profile-switch-x"></i>
                    </span>
                </summary>
                <div class="profile-switch-popup">
                    <div class="profile-switch-popup-title">@(isSuperAdmin ? "Super admin account" : "Admin account")</div>
                    <a class="profile-switch-action" asp-controller="AccountProfile" asp-action="Index">
                        <i class="fa-solid fa-user-gear" aria-hidden="true"></i>
                        Edit profile &amp; security
                    </a>
                </div>
            </details>
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="admin-logout"><i class="fa-solid fa-right-from-bracket"></i> Sign out
                </button>
            </form>
        </div>
    </aside>
    <div class="admin-workspace">
        <header class="admin-topbar">
            <button class="admin-menu-toggle" id="admin-menu-toggle" type="button" aria-controls="admin-sidebar"
                    aria-expanded="false" aria-label="Open menu"><i class="fa-solid fa-bars"></i></button>
            <div class="admin-topbar-heading"><span>@(isSuperAdmin ? "SUPER ADMIN" : "ADMIN")</span><strong>@ViewData["Title"]</strong></div>
            <a class="admin-bell" data-notification-link asp-controller="Notification" asp-action="Index" aria-label="Notifications">
                <i class="fa-regular fa-bell"></i>
                @if (unread > 0)
                {
                <span>@notificationBadge</span>
                }
            </a>
        </header>
        <main class="admin-content">
            @if (TempData["AdminMessage"] is string message)
            {
            <div class="admin-notice success" role="status">@message</div>
            }
            @if (TempData["AdminError"] is string error)
            {
            <div class="admin-notice error" role="alert">@error</div>
            }
            @RenderBody()
        </main>
    </div>
</div>
<nav class="admin-mobile-nav" aria-label="Mobile administration navigation">
    <a class="@Active("Index")" asp-controller="Admin" asp-action="Index"><i
            class="fa-solid fa-house"></i><span>Home</span></a>
    <a class="@Active("ProviderRegistrations", "ProviderRegistrationDetails")" asp-controller="Admin"
       asp-action="ProviderRegistrations"><i class="fa-solid fa-user-doctor"></i><span>Providers</span></a>
    <a class="@Active("Medications", "MedicationDetails")" asp-controller="Admin" asp-action="Medications"><i
            class="fa-solid fa-capsules"></i><span>Medicines</span></a>
    <button type="button" id="admin-mobile-more" aria-controls="admin-sidebar" aria-expanded="false"><i
            class="fa-solid fa-ellipsis"></i><span>More</span></button>
</nav>
<script>
    (() => {
        const sidebar = document.getElementById('admin-sidebar');
        const backdrop = document.getElementById('admin-backdrop');
        const openers = [document.getElementById('admin-menu-toggle'), document.getElementById('admin-mobile-more')];
        const closer = document.getElementById('admin-close');
        const mq = window.matchMedia('(max-width: 820px)');
        let prior = null;
        const focusable = () => [...sidebar.querySelectorAll('a,button')].filter(x => x.getClientRects().length);

        function setOpen(open) {
            const visible = open && mq.matches;
            document.body.classList.toggle('admin-drawer-open', visible);
            openers.forEach(b => b.setAttribute('aria-expanded', String(visible)));
            sidebar.inert = mq.matches && !visible;
            if (visible) {
                prior = document.activeElement;
                closer.focus();
            } else if (prior) {
                prior.focus();
                prior = null;
            }
        }

        openers.forEach(b => b.addEventListener('click', () => setOpen(true)));
        closer.addEventListener('click', () => setOpen(false));
        backdrop.addEventListener('click', () => setOpen(false));
        sidebar.querySelectorAll('nav a').forEach(a => a.addEventListener('click', () => setOpen(false)));
        document.addEventListener('keydown', e => {
            if (!document.body.classList.contains('admin-drawer-open')) return;
            if (e.key === 'Escape') {
                setOpen(false);
                return;
            }
            if (e.key !== 'Tab') return;
            const items = focusable();
            if (!items.length) return;
            if (e.shiftKey && document.activeElement === items[0]) {
                e.preventDefault();
                items[items.length - 1].focus();
            } else if (!e.shiftKey && document.activeElement === items[items.length - 1]) {
                e.preventDefault();
                items[0].focus();
            }
        });
        mq.addEventListener('change', () => setOpen(false));
        setOpen(false);
    })();
</script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/live-notifications.js" asp-append-version="true" defer></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
