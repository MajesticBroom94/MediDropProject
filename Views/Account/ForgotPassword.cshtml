@model MediDropProject.Models.Account.ForgotPasswordViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
    ViewData["Title"] = "Forgot password | MediDrop";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#eaf5fa" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/png" href="~/images/medidrop-logo.png" asp-append-version="true" />
    <link rel="stylesheet" href="@Url.Content("~/css/account/medidrop-login.css")" asp-append-version="true" />
    <link rel="stylesheet" href="@Url.Content("~/css/account/password-recovery.css")" asp-append-version="true" />
</head>
<body>
    <main class="auth-page">
        <div class="auth-shell">
            <header class="brand">
                <img class="brand-logo" src="@Url.Content("~/images/medidrop-logo.png")"
                     alt="MediDrop dispenser logo" width="100" height="100" />
                <h1>MediDrop</h1>
                <p>Towards better health, one step at a time.</p>
            </header>
            <section class="auth-card" aria-labelledby="recovery-title">
    <div class="recovery-symbol" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="4" y="10" width="16" height="11" rx="2" />
            <path d="M8 10V7a4 4 0 0 1 8 0v3" />
            <path d="M12 14v3" />
        </svg>
    </div>
    <h2 id="recovery-title">Forgot your password?</h2>
    <p class="card-subtitle">Enter the email address linked to your MediDrop account. We'll send you a secure link to reset your password.</p>

    <form asp-controller="Account" asp-action="ForgotPassword" method="post" id="recovery-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

        <div class="field">
            <label asp-for="Email">Email address</label>
            <input asp-for="Email" type="email" autocomplete="email" inputmode="email"
                   placeholder="Enter your email address" required autofocus />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>

        <button type="submit" class="sign-in" id="recovery-submit">
            <span>Send reset link</span>
            <span class="button-spinner" aria-hidden="true"></span>
        </button>
    </form>

    <div class="auth-divider"></div>
    <a class="register-link" asp-controller="Account" asp-action="Login">Back to sign in</a>
</section>
        </div>
    </main>
    <script>
    document.getElementById('recovery-form').addEventListener('submit', function () {
        if (this.checkValidity()) {
            const button = document.getElementById('recovery-submit');
            button.disabled = true;
            button.classList.add('loading');
        }
    });
</script>
</body>
</html>
