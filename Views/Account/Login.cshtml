@using MediDropProject.Domain.Enums
@model MediDropProject.Models.Account.LoginViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
    ViewData["Title"] = "Sign in | MediDrop";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#eaf5fa" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/png" href="~/images/medidrop-logo.png" asp-append-version="true" />
    <link rel="stylesheet" href="@Url.Content("~/css/account/medidrop-login.css")" />
</head>
<body>
    <main class="auth-page">
        <div class="auth-shell">
            <header class="brand">
                <img class="brand-logo" src="@Url.Content("~/images/medidrop-logo.png")"
                     alt="MediDrop dispenser logo" width="100" height="100" />
                <h1>MediDrop</h1>
                <p>Towards better health, one step at a time.</p>
            </header>

            <section class="auth-card" aria-labelledby="login-title">
                <h2 id="login-title">Welcome back</h2>
                <p class="card-subtitle">Sign in to your account</p>

                <form id="login-form" method="post" action="@Url.Action("Login", "Account")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="validation-summary" role="alert" aria-live="polite">
                            @Html.ValidationSummary(false)
                        </div>
                    }

                    <fieldset class="profile-picker">
                        <legend>Continue as</legend>
                        <div class="profile-options">
                            <label class="profile-option">
                                <input asp-for="SelectedProfile" type="radio"
                                       id="login-patient" value="@LastSelectedProfile.Patient" />
                                <span>Patient</span>
                            </label>
                            <label class="profile-option">
                                <input asp-for="SelectedProfile" type="radio"
                                       id="login-provider" value="@LastSelectedProfile.CareProvider" />
                                <span>Care Provider</span>
                            </label>
                        </div>
                        <span asp-validation-for="SelectedProfile" class="field-error"></span>
                    </fieldset>

                    <div class="field">
                        <label for="Email">Email address</label>
                        <input asp-for="Email" id="Email" type="email"
                               autocomplete="username" inputmode="email"
                               placeholder="Enter your email address" required autofocus />
                        <span asp-validation-for="Email" class="field-error"></span>
                    </div>

                    <div class="field">
                        <label for="Password">Password</label>
                        <div class="password-field">
                            <input asp-for="Password" id="Password" type="password"
                                   autocomplete="current-password"
                                   placeholder="Enter your password" required />
                            <div class="forgot-password-link">
                                <a asp-controller="Account"asp-action="ForgotPassword">Forgot your password?</a>
                            </div>
                            <button id="password-toggle" class="password-toggle" type="button"
                                    aria-label="Show password" aria-pressed="false">
                                <svg viewBox="0 0 24 24" width="21" height="21"
                                     fill="none" stroke="currentColor"
                                     stroke-width="1.8" stroke-linecap="round"
                                     stroke-linejoin="round" aria-hidden="true">
                                    <path d="M2 12s3.5-6.5 10-6.5S22 12 22 12s-3.5 6.5-10 6.5S2 12 2 12Z"/>
                                    <circle cx="12" cy="12" r="3"/>
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="field-error"></span>
                    </div>

                    <button class="sign-in" id="sign-in" type="submit">
                        <span>Sign In</span>
                        <span class="button-spinner" aria-hidden="true"></span>
                    </button>
                </form>

                <div class="auth-divider"></div>
                <p class="new-account">New to MediDrop?</p>
                <a class="register-link" id="register-link"
                   href="@Url.Action("Register", "Account")">
                    Create an account
                </a>
            </section>
        </div>
    </main>

    <script>
        (() => {
            const password = document.getElementById('Password');
            const toggle = document.getElementById('password-toggle');
            const form = document.getElementById('login-form');
            const button = document.getElementById('sign-in');
            const registerLink = document.getElementById('register-link');
            const registerBaseUrl = '@Url.Action("Register", "Account")';
            document.querySelectorAll('input[name="SelectedProfile"]').forEach(radio => {
                radio.addEventListener('change', () => {
                    if (radio.checked)
                        registerLink.href = registerBaseUrl + '?profile=' + encodeURIComponent(radio.value);
                });
            });
            toggle.addEventListener('click', () => {
                const visible = password.type === 'text';
                password.type = visible ? 'password' : 'text';
                toggle.setAttribute('aria-pressed', String(!visible));
                toggle.setAttribute('aria-label', visible ? 'Show password' : 'Hide password');
            });
            form.addEventListener('submit', () => {
                if (form.checkValidity()) {
                    button.disabled = true;
                    button.classList.add('loading');
                }
            });
        })();
    </script>
</body>
</html>
