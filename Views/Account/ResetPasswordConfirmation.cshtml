@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
    ViewData["Title"] = "Password updated | MediDrop";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#eaf5fa" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/png" href="~/images/medidrop-logo.png" asp-append-version="true" />
    <link rel="stylesheet" href="@Url.Content("~/css/account/medidrop-login.css")" asp-append-version="true" />
    <link rel="stylesheet" href="@Url.Content("~/css/account/password-recovery.css")" asp-append-version="true" />
</head>
<body>
    <main class="auth-page">
        <div class="auth-shell">
            <header class="brand">
                <img class="brand-logo" src="@Url.Content("~/images/medidrop-logo.png")"
                     alt="MediDrop dispenser logo" width="100" height="100" />
                <h1>MediDrop</h1>
                <p>Towards better health, one step at a time.</p>
            </header>
            <section class="auth-card" aria-labelledby="success-title">
    <div class="recovery-symbol recovery-symbol--success" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9" /><path d="m8 12 2.5 2.5L16 9" />
        </svg>
    </div>
    <h2 id="success-title">Password updated</h2>
    <p class="card-subtitle">Your password has been reset. You can now sign in to MediDrop using your new password.</p>
    <a class="sign-in recovery-button-link" asp-controller="Account" asp-action="Login">Sign in to MediDrop</a>
</section>
        </div>
    </main>
    
</body>
</html>
