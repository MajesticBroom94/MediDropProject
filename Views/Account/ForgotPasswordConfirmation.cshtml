@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
    ViewData["Title"] = "Check your email | MediDrop";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#eaf5fa" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/png" href="~/images/medidrop-logo.png" asp-append-version="true" />
    <link rel="stylesheet" href="@Url.Content("~/css/account/medidrop-login.css")" asp-append-version="true" />
    <link rel="stylesheet" href="@Url.Content("~/css/account/password-recovery.css")" asp-append-version="true" />
</head>
<body>
    <main class="auth-page">
        <div class="auth-shell">
            <header class="brand">
                <img class="brand-logo" src="@Url.Content("~/images/medidrop-logo.png")"
                     alt="MediDrop dispenser logo" width="100" height="100" />
                <h1>MediDrop</h1>
                <p>Towards better health, one step at a time.</p>
            </header>
            <section class="auth-card" aria-labelledby="confirmation-title">
    <div class="recovery-symbol recovery-symbol--success" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m3 7 9 6 9-6" />
        </svg>
    </div>
    <h2 id="confirmation-title">Check your email</h2>
    <p class="card-subtitle">If an account exists for that email address, we've sent instructions to reset its password.</p>
    <div class="recovery-note">
        <strong>Didn't receive an email?</strong>
        <p>Check your spam or junk folder. The link may take a little while to arrive.</p>
    </div>
    <a class="sign-in recovery-button-link" asp-controller="Account" asp-action="Login">Back to sign in</a>
    <div class="auth-divider"></div>
    <a class="register-link" asp-controller="Account" asp-action="ForgotPassword">Try another email address</a>
</section>
        </div>
    </main>
    
</body>
</html>
